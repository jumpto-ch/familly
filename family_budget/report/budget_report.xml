<odoo>
    <!-- Report action -->
    <record id="action_report_familly_budget" model="ir.actions.report">
        <field name="name">Family Budget</field>
        <field name="model">familly.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">family_budget.report_familly_budget</field>
        <field name="report_file">family_budget.report_familly_budget</field>
        <field name="print_report_name">'Budget - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_familly_budget"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report template -->
    <template id="report_familly_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <t t-set="income_sections" t-value="doc._group_lines_by_section(doc.income_line_ids)"/>
                        <t t-set="expense_sections" t-value="doc._group_lines_by_section(doc.expense_line_ids)"/>

                        <h2>
                            Budget familial : <span t-field="doc.name"/>
                        </h2>

                        <div class="row mt-2 mb-4">
                            <div class="col-6">
                                <strong>Version :</strong> <span t-field="doc.version"/><br/>
                                <strong>Périodicité :</strong>
                                <span t-field="doc.frequency"/>
                            </div>
                            <div class="col-6">
                                <strong>Période :</strong>
                                <span t-if="doc.date_start">
                                    du <span t-field="doc.date_start"/>
                                </span>
                                <span t-if="doc.date_end">
                                    au <span t-field="doc.date_end"/>
                                </span>
                            </div>
                        </div>

                        <!-- Revenus -->
                        <h3>Revenus</h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Compte</th>
                                    <th>Libellé</th>
                                    <th class="text-end">Montant</th>
                                </tr>
                            </thead>
                            <tbody t-foreach="income_sections" t-as="section" style="page-break-inside: avoid;">
                                <tr t-if="section['name']" class="table-active">
                                    <td colspan="3"><strong t-esc="section['name']"/></td>
                                </tr>
                                <tr t-foreach="section['lines']" t-as="line">
                                    <td><span t-field="line.account_id.display_name"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-field="line.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-if="section['name']">
                                    <td colspan="2" class="text-end"><em>Sous-total <t t-esc="section['name']"/></em></td>
                                    <td class="text-end"><em><span t-esc="section['subtotal']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></em></td>
                                </tr>
                            </tbody>
                            <tbody t-if="not doc.income_line_ids">
                                <tr>
                                    <td colspan="3" class="text-muted">Aucun revenu.</td>
                                </tr>
                            </tbody>
                            <tbody style="page-break-inside: avoid;">
                                <tr>
                                    <td colspan="2" class="text-end border-top border-dark"><strong>Total des revenus</strong></td>
                                    <td class="text-end border-top border-dark">
                                        <strong>
                                            <span t-field="doc.total_incomes"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Dépenses -->
                        <h3 class="mt-4">Dépenses</h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Compte</th>
                                    <th>Libellé</th>
                                    <th class="text-end">Montant</th>
                                </tr>
                            </thead>
                            <tbody t-foreach="expense_sections" t-as="section" style="page-break-inside: avoid;">
                                <tr t-if="section['name']" class="table-active">
                                    <td colspan="3"><strong t-esc="section['name']"/></td>
                                </tr>
                                <tr t-foreach="section['lines']" t-as="line">
                                    <td><span t-field="line.account_id.display_name"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-field="line.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-if="section['name']">
                                    <td colspan="2" class="text-end"><em>Sous-total <t t-esc="section['name']"/></em></td>
                                    <td class="text-end"><em><span t-esc="section['subtotal']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></em></td>
                                </tr>
                            </tbody>
                            <tbody t-if="not doc.expense_line_ids">
                                <tr>
                                    <td colspan="3" class="text-muted">Aucune dépense.</td>
                                </tr>
                            </tbody>
                            <tbody style="page-break-inside: avoid;">
                                <tr>
                                    <td colspan="2" class="text-end border-top border-dark"><strong>Total des dépenses</strong></td>
                                    <td class="text-end border-top border-dark">
                                        <strong>
                                            <span t-field="doc.total_expenses"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Résumé -->
                        <t t-set="named_expense_sections" t-value="[s for s in expense_sections if s['name']]"/>
                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td class="text-end"><strong>Total des revenus</strong></td>
                                        <td class="text-end">
                                            <span t-field="doc.total_incomes"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-end"><strong>Total des dépenses</strong></td>
                                        <td class="text-end">
                                            <span t-field="doc.total_expenses"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-end"><strong>Solde</strong></td>
                                        <td class="text-end">
                                            <span t-esc="doc.total_incomes - doc.total_expenses"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row" t-if="named_expense_sections">
                            <div class="col-6 offset-6">
                                <div class="text-muted fw-light">Sous-totaux des dépenses</div>
                                <t t-foreach="named_expense_sections" t-as="section">
                                    <div class="d-flex justify-content-between text-muted fw-light">
                                        <span t-esc="section['name']"/>
                                        <span t-esc="section['subtotal']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
