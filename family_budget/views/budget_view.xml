<odoo>
    <!-- Action -->
    <record id="action_familly_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">familly.budget</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree view -->
    <record id="view_familly_budget_tree" model="ir.ui.view">
        <field name="name">familly.budget.tree</field>
        <field name="model">familly.budget</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="version"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="frequency"/>
                <field name="total_incomes" sum="Total Revenues" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_expenses" sum="Total Expenses" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-success="state =='active'"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_familly_budget_form" model="ir.ui.view">
        <field name="name">familly.budget.form</field>
        <field name="model">familly.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="%(action_report_familly_budget)d"
                            string="Print"
                            type="action"
                            class="btn-secondary"/>

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Not balanced" bg_color="text-bg-danger" invisible="balanced"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Budget's Name" required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="version"/>
                            <field name="frequency"/>
                            <field name="next_execution_date" readonly="1"/>
                        </group>
                        <group>
                            <label for="date_start" string="Period"/>
                            <div>
                                <div name="date_edit_only" class="o_row oe_edit_only">
                                    <field name="date_start" class="oe_inline"/>
                                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="date_end" class="oe_inline"/>
                                </div>
                                <div name="date_read_only" class="o_row oe_read_only">
                                    <span invisible="not date_start">From <field name="date_start" class="oe_inline"/></span>
                                    <span invisible="not date_end">To <field name="date_end" class="oe_inline"/></span>
                                </div>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="incomes">
                            <field name="income_line_ids">
                                <tree editable="bottom" default_order="sequence, id">
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="type" column_invisible="True"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="sequence" widget="handle"/>
                                        <field name="account_id"  groups="account.group_account_readonly" options="{'no_quick_create': True}"/>
                                        <field name="name" optional="show"/>
                                        <field name="amount" string="Amount"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </tree>
                            </field>
                        </page>

                        <page string="Expenses">
                            <field name="expense_line_ids">
                                <tree editable="bottom" default_order="sequence, id">
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="type" column_invisible="True"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="sequence" widget="handle"/>
                                        <field name="account_id"  groups="account.group_account_readonly" options="{'no_quick_create': True}"/>
                                        <field name="name" optional="show"/>
                                        <field name="amount" string="Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </tree>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="total_incomes" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="total_expenses" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="balanced" readonly="1"/>
                    </group>

                    <div invisible="balanced">
                        <span class="o_form_label">⚠ Budget not balanced! incomes must equal expenses.</span>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="familly_budget_search_view" model="ir.ui.view">
        <field name="name">familly.budget.search</field>
        <field name="model">familly.budget</field>
        <field name="arch" type="xml">
            <search>
                <filter
                        string="Archived"
                        name="archived"
                        domain="[('active','=',False)]"/>

            </search>
        </field>
    </record>

</odoo>
